{
  "manifest_version": 3,
  "name": "DocLens – Docs QA Copilot",
  "short_name": "DocLens",
  "version": "1.0.0",
  "description": "One-click QA for any documentation page: broken links and images, SEO checks, style guide lint, and AI-written bug reports.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open DocLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/console-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
