# Models are fetched live from each provider's /models API - nothing is hard-coded.
# ---------------- Server ----------------
PORT=8090
CORS_ORIGIN=http://localhost:5173

# ---------------- LLM providers ----------------
# A provider only appears in the UI when its API key is set.
# (Legacy lower-case names like groq_API_KEY are also accepted.)

# Groq
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
# Optional preferred default model (must exist in the live list, otherwise the first available model is used)
GROQ_MODEL=

# Inception Labs
INCEPTION_API_KEY=
INCEPTION_API_BASE=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=

# Auto-switch behaviour
# LLM_AUTO_SWITCH=true            # default state of the UI toggle
# LLM_PROVIDER_ORDER=groq,inception  # fallback priority between providers
# LLM_MAX_ATTEMPTS=6              # max models tried per request
# LLM_TIMEOUT_MS=90000

# ---------------- Jira ----------------
# The "Connect to Jira" button only appears when JIRA_API_KEY is set.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_KEY=
# Optional: issue types to list (default: Story)
# JIRA_ISSUE_TYPES=Story
# Optional: Acceptance Criteria custom field id(s); auto-detected by name if omitted
# JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_10035
# JIRA_MAX_STORIES=300

# ---------------- Approved test cases -> Jira test management ----------------
# Which Jira test management app receives approved test cases: xray | zephyr | aio
# The app must be installed in your Jira site and enabled for the target project.
TEST_MANAGEMENT_TOOL=
# Optional default Jira project key for new test cases (the UI uses the loaded story's project first)
# TEST_MANAGEMENT_PROJECT_KEY=SCRUM

# Xray: Jira settings > Apps > Xray > API Keys > Create API Key (secret is shown once)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# Optional region: https://eu.xray.cloud.getxray.app | https://us.xray.cloud.getxray.app | https://au.xray.cloud.getxray.app
# XRAY_API_BASE=https://xray.cloud.getxray.app
# Optional Jira link type used to link tests to the story (Xray default: "Test")
# XRAY_TEST_LINK_TYPE=Test

# Zephyr (formerly Zephyr Scale; not legacy Zephyr Squad):
# Jira > your profile picture > Zephyr API Access Tokens > Create access token
ZEPHYR_API_TOKEN=
# Optional region: EU https://eu.api.zephyrscale.smartbear.com/v2 | AU https://au.api.zephyrscale.smartbear.com/v2 | DE https://de.api.zephyrscale.smartbear.com/v2
# ZEPHYR_API_BASE=https://api.zephyrscale.smartbear.com/v2

# AIO Tests: Jira > AIO Tests > gear icon > My Settings > API Token > Generate
AIO_API_TOKEN=
# Optional: API URL shown on that same page (EU sites: https://tcms-prod-eu.aiojiraapps.com/aio-tcms/api/v1)
# AIO_API_BASE=https://tcms.aiojiraapps.com/aio-tcms/api/v1
